__pycache__/
*.pyc
.DS_Store
.venv/
.pytest_cache/
*.egg-info/

# Secrets — never commit API keys.
.env

# Raw downloaded evidence stays local/external. Only normalized manifests
# and reports are small enough, and meant, to live in this repository.
DATA/raw/
DATA/logs/
DATA/checkpoints/
!DATA/raw/.gitkeep
!DATA/logs/.gitkeep
!DATA/checkpoints/.gitkeep

# Job 15's per-run generated query registries (regenerated identically from
# configs/known_adc_assets.yaml + fixed templates every run — not
# standalone evidence, same reasoning as raw/logs/checkpoints above).
DATA/generated_queries/
!DATA/generated_queries/.gitkeep
