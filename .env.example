# Copy this file to .env (which is gitignored) and fill in real values.
# NCBI E-utilities API key. Optional but raises the rate limit from 3 req/s
# to 10 req/s. https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=
NCBI_TOOL_NAME=adc-acquisition
NCBI_CONTACT_EMAIL=

# Optional: contact email for Crossref's "polite pool".
CROSSREF_CONTACT_EMAIL=

# Required for the SEC EDGAR job. SEC returns HTTP 403 (and may briefly
# block the IP) for requests without a real identifying User-Agent —
# https://www.sec.gov/os/webmaster-faq#developers.
SEC_CONTACT_EMAIL=

# Optional for the FDA job. Free at https://open.fda.gov/apis/authentication/ —
# raises the daily quota from 1,000 to 120,000 requests; never required.
FDA_API_KEY=

# Required for the WIPO job (queries EPO's Open Patent Services for
# WO-prefixed PCT publications — WIPO PATENTSCOPE itself has no public API
# and its Terms of Use forbid automated access). Free registration at
# https://developers.epo.org/.
OPS_CONSUMER_KEY=
OPS_CONSUMER_SECRET=

# Required for the USPTO job. Free registration at https://data.uspto.gov/
# (USPTO's Open Data Portal, Patent File Wrapper API — PatentsView was
# shut down 2026-03-20; developer.uspto.gov is also decommissioned).
# Weekly quota: 1,200,000 document retrievals, 5,000,000 metadata
# retrievals (verified live 2026-08-13).
USPTO_API_KEY=
